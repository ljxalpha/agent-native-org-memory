#!/usr/bin/env python3
"""hermes-memory-distill — HermesToolProvider bridge (EXPERIMENTAL).

This is an **experimental integration entry point, not the production
distillation backend**. Production distillation runs through
``--provider deepseek`` (``OpenAICompatProvider``); see §5.3.2 of
``mvp_tech_design.md``. This bridge must not appear in any production profile,
and its output is not the baseline for product-equivalence checks: the channel
carries a single text prompt, so the system/user role boundary is lost and there
is no service-level structured-output constraint.

What it does prove is that the ``LLMProvider`` abstraction can host an
out-of-process backend, over a real subprocess + JSON boundary, at zero quota.

Bridges the distiller's ``--provider hermes_tool`` path to an external process.
It speaks the exact JSON contract defined in
``memory_net/distiller/llm/hermes_tool.py``:

    stdin  : {"system_prompt": str, "user_prompt": str, "model": str,
              "max_tokens": int, "metadata": {...}}
    stdout : {"text": str, "model": str, "usage": {"input_tokens": int, ...},
              "usage_source": str, "provider_backend": str, "raw_meta": {str: str}}

The three provenance keys are optional: a bridge that omits them is read as
``unknown`` / ``hermes_tool`` / ``{}``. Emitting them is how a real backend
behind this bridge stays visible in the run-level provenance aggregate.

``text`` is the distillation-result JSON that ``DistillationPipeline`` then parses
into team products. A non-zero exit with a stderr message signals failure (the
provider raises ``RuntimeError`` on a non-zero return code).

Backend (zero LLM quota): this produces the SAME deterministic output as the
in-process ``MockLLMProvider``, so the whole ``hermes_tool`` pipeline can be
exercised end to end over a real process + JSON boundary without spending tokens.
It stays a mock **by design**: what this script exercises is the protocol, not a
model, and swapping in a real agent here would not fix the channel limitations
above — it would only make an experimental path look production-grade.

Usage (real CLI):
    HERMES_TOOL_COMMAND="$(command -v python3) scripts/hermes-memory-distill" \
        python -m memory_net.distiller.cli run --provider hermes_tool --repo <repo>
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

# Self-locate the repo root so the bridge imports cleanly regardless of the
# caller's cwd or PYTHONPATH (the provider invokes us as a bare subprocess).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from memory_net.distiller.llm.base import LLMRequest, LLMResponse  # noqa: E402
from memory_net.distiller.llm.mock import MockLLMProvider  # noqa: E402


def produce_response(request: LLMRequest) -> LLMResponse:
    """Produce the distillation response for one request.

    Deterministic mock distillation (zero quota). Reusing ``MockLLMProvider``
    keeps the bridge output from ever drifting from the in-process mock path,
    which is the point: this script is a protocol conformance fixture.
    """
    return MockLLMProvider().generate(request)


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(f"hermes-memory-distill: invalid request JSON: {exc}", file=sys.stderr)
        return 1
    if not isinstance(payload, dict):
        print("hermes-memory-distill: request must be a JSON object", file=sys.stderr)
        return 1

    request = LLMRequest(
        system_prompt=str(payload.get("system_prompt", "")),
        user_prompt=str(payload.get("user_prompt", "")),
        model=str(payload.get("model", "")),
        max_tokens=int(payload.get("max_tokens", 2000)),
        metadata=dict(payload.get("metadata") or {}),
    )

    try:
        response = produce_response(request)
    except Exception as exc:  # surface as a non-zero exit per the provider contract
        print(f"hermes-memory-distill: distillation failed: {exc}", file=sys.stderr)
        return 1

    json.dump(
        {
            "text": response.text,
            "model": response.model,
            "usage": response.usage,
            # Relayed verbatim from whatever backend produced_response() used, so
            # the distiller aggregates the real backend rather than this bridge.
            "usage_source": response.usage_source,
            "provider_backend": response.provider_backend,
            "raw_meta": response.raw_meta,
        },
        sys.stdout,
        ensure_ascii=False,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
