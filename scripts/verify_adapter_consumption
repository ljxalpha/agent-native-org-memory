#!/usr/bin/env python3
"""verify_adapter_consumption — does an agent actually follow an injected hint?

    verify_adapter_consumption --adapter config/adapters/hermes.yaml \
        --runtime-root <agent source tree> [--model M --provider P] [--dry-run]

Two runs inside the sandbox, identical but for one thing: the injected hint.
Both have the same ``INDEX.md`` carrying the same fresh sentinel; only the
first has the reference to it installed in ``AGENTS.md``. The sentinel is
sixteen random characters that live in exactly one file. If it comes back in
the first answer and not the second, the hint is what took the agent there.

"Identical" has to include the agent's own state, which a run mutates -- its
database, caches and logs all live under the sandbox home. So the home is
restored from a pristine copy before each run; without that, the control is
the second half of a sequence rather than a comparison.

Python rather than shell, and not only for the usual reason. This has to mint a
sentinel, take a before/after set difference over the session directory, and
apply a dozen decision rules -- and every one of those rules has to be testable
without running an agent, which means it belongs in an importable module rather
than in a script's control flow.

``--dry-run`` prints the argv of both runs and writes nothing, which is how the
argv contract is tested at no cost.
"""

from __future__ import annotations

import argparse
import json
import os
import secrets
import shutil
import subprocess
import sys
from collections.abc import Mapping, Sequence
from pathlib import Path

import yaml  # type: ignore[import-untyped]

if __package__ in (None, ""):  # pragma: no cover - direct script execution
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from memory_net.distiller.agent_trace import (
    ConsumptionEvidence,
    ConsumptionVerdict,
    verify_consumption,
)
from memory_net.distiller.llm.ledger import AttemptLedger
from memory_net.shared.adapters import FileSystemMdAdapter

SANDBOX = Path(__file__).resolve().parent / "agent_sandbox"

DEFAULT_MAX_ITERATIONS = 2
"""Tool-calling iterations one agent invocation may make.

An agent in a tool loop decides how many times it calls a model, and nothing
outside it can know the number before the calls happen. Without a cap the
budget for this check is a hope. Two is the minimum that can succeed: one call
to decide on the read, one to answer with what came back.
"""


def calls_per_run(max_iterations: int) -> int:
    """Wire requests one invocation can make, which is *not* the iteration cap.

    On exhausting its iteration budget the agent makes one further, toolless
    request to summarise (`agent/turn_finalizer.py`), so N iterations permit
    N+1 requests. Charging the iteration count would under-count every capped
    run -- the direction that makes a ledger useless, since it under-reports
    exactly when the cap binds.

    This bounds the error-free, non-delegating path only. Retries inside one
    iteration do not advance the iteration counter, and nothing here interposes
    on egress, so the figure is an upper-bound claim rather than a bill.
    """
    return max_iterations + 1


FILE_TOOLSET = ("read_file", "search_files", "patch", "write_file")
"""What the ``file`` toolset offers, measured. It includes write tools, which is
why the agent root is mounted read-only for this check."""

PROMPT = "Reply with the verification token and nothing else."
"""Names no file, no path, and no instruction file. It contains no token.

An earlier version asked for "the team memory index that your instructions
reference". That sentence is itself a pointer: it tells the agent such an index
exists and is worth looking for, and the first real run showed an agent with
file tools acts on exactly that -- it found and read the index with no hint
present at all. A prompt that describes the target cannot be used to test
whether something else described the target.

So the prompt asks only for the answer. In the positive run the injected hint
is the sole thing that says where to look; in the control nothing does. An
agent that goes looking anyway is not a failure of the design -- it is what the
control is there to catch, and it makes the check fail loudly rather than pass
for the wrong reason.
"""

INDEX_TEMPLATE = """# Team Memory Index

Verification token: {sentinel}

This index is written by the adapter consumption check. The token above exists
in this file and nowhere else.
"""


def new_sentinel() -> str:
    """Sixteen lowercase alphanumerics, fresh for every verification.

    Fresh matters: a fixed token could be answered from a cached response, or
    from a previous run's state, and the check would pass without the agent
    having read anything this time.
    """
    alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
    return "".join(secrets.choice(alphabet) for _ in range(16))


def sandbox_argv(
    *,
    runtime_root: Path,
    root: Path,
    model: str,
    provider: str,
    hermes: str,
    max_iterations: int,
) -> list[str]:
    """The full command line for one verification run.

    ``--read-only-agentroot`` is not optional here: the toolset this check needs
    includes write tools, and a namespace that cannot be written to is a
    structural limit rather than an after-the-fact check.

    ``-Q`` is required for the opposite reason: the sentinel is looked for in
    stdout, so anything printed there other than the model's answer -- a tool
    preview, a progress line echoing the file just read -- is a way for the
    check to find its own input and call it evidence.

    Two flags must never appear, for the same reason. ``--safe-mode`` implies
    ignoring the user config and disables instruction-file and memory injection
    outright. ``--ignore-rules`` reads like hygiene -- "the rule files are the
    user's, not this check's" -- and maps to ``skip_context_files=True``, so
    AGENTS.md is never loaded into the system prompt at all. A run with it
    cannot observe a hint being followed, because there is no hint in the
    prompt to follow. Isolation from the user's own files is the sandbox's job
    and is already structural: HERMES_HOME and the working directory both point
    inside the namespace, where the user's files do not exist.
    """
    return [
        sys.executable,
        str(SANDBOX),
        "--runtime-root",
        str(runtime_root),
        "--root",
        str(root),
        "run",
        "--read-only-agentroot",
        # The only structural bound on this run's cost.
        "--limit",
        f"HERMES_MAX_ITERATIONS={max_iterations}",
        "--",
        hermes,
        # `chat -q` rather than the top-level `-z`: they are both one-shot, but
        # `-Q` is defined only on this subparser, and the top-level form
        # rejects it as an unknown argument.
        "chat",
        "-q",
        PROMPT,
        "-m",
        model,
        "--provider",
        provider,
        # Final response only: no banner, no spinner, no tool previews. The
        # check looks for the sentinel in stdout, and a tool preview echoing
        # the file it just read would put the sentinel there without the model
        # ever having produced it -- the evidence would be the check watching
        # itself work.
        "-Q",
    ]


def prepare(
    root: Path,
    *,
    adapter_path: Path,
    sentinel: str,
    inject_hint: bool,
) -> tuple[str, str]:
    """Set up the sandbox agent root; return ``(index_text, instructions)``.

    ``inject_hint=False`` builds the control, and the index is still written.

    One variable, and which one matters. A control that dropped the hint *and*
    the index would compare "hint present, file present" against "neither" --
    so an agent that found the file by searching the tree, rather than by
    following the reference, would produce exactly the passing pattern. The
    thing under test is the reference, so the reference is the only thing that
    changes.
    """
    agent_root = root / "agentroot"
    if agent_root.exists():
        shutil.rmtree(agent_root)
    agent_root.mkdir(parents=True)
    instructions = agent_root / "AGENTS.md"
    instructions.write_text(
        "# Agent instructions\n\nFollow the references in this file.\n",
        encoding="utf-8",
    )
    index = agent_root / "memory" / "team" / "INDEX.md"
    index.parent.mkdir(parents=True, exist_ok=True)
    index_text = INDEX_TEMPLATE.format(sentinel=sentinel)
    index.write_text(index_text, encoding="utf-8")
    if inject_hint:
        os.environ.setdefault("MEMORY_NET_ALLOW_EXPERIMENTAL_ADAPTER", "1")
        adapter = FileSystemMdAdapter.from_yaml(adapter_path, agent_root=agent_root)
        adapter.inject_team_hint(adapter.hint_config)
    return index_text, instructions.read_text(encoding="utf-8")


REQUIRED_TOOLSET = ["file"]
"""The exact toolset this check runs with.

Checked as well as the turn cap, because a wider one is a second way to blow
the budget rather than a nicety: a delegation tool starts child agents whose
iteration budgets are their own and much larger.
"""


def _remedy(max_iterations: int) -> str:
    return (
        "sandbox is not configured for this check; re-run "
        f"`agent_sandbox up --toolset file --max-turns {max_iterations}`"
    )


def assert_turn_cap(root: Path, max_iterations: int = DEFAULT_MAX_ITERATIONS) -> None:
    """Refuse to start unless the sandbox config carries the cap and the toolset.

    Both live in a file written by a *previous* command
    (``agent_sandbox up``). Assuming they are there is how a run costs ninety
    calls instead of three: the agent's own default is 90, and its config file
    outranks the environment variable that looks like the limit.

    Nothing parsed out of that file reaches the error message. It is a config
    an operator may have edited, this runs next to credential material, and a
    diagnostic that echoes file contents is a way for the next value someone
    puts there to end up in a terminal and a CI log.
    """
    config = root / "home" / ".hermes" / "config.yaml"
    if not config.is_file():
        raise SystemExit(_remedy(max_iterations))
    try:
        loaded = yaml.safe_load(config.read_text(encoding="utf-8"))
    except (yaml.YAMLError, OSError, UnicodeDecodeError):
        # Not chained: PyYAML's diagnostics quote the offending source line.
        raise SystemExit(_remedy(max_iterations)) from None
    if not isinstance(loaded, Mapping):
        raise SystemExit(_remedy(max_iterations))
    agent = loaded.get("agent")
    turns = agent.get("max_turns") if isinstance(agent, Mapping) else None
    if not isinstance(turns, int) or isinstance(turns, bool) or turns != max_iterations:
        raise SystemExit(_remedy(max_iterations))
    toolsets = loaded.get("platform_toolsets")
    offered = toolsets.get("cli") if isinstance(toolsets, Mapping) else None
    if offered != REQUIRED_TOOLSET:
        raise SystemExit(_remedy(max_iterations))


CONTEXT_SECTION = "context (AGENTS.md/cwd files)"
"""The prompt-size section that carries the instruction file.

Named by the agent itself (`hermes_cli/prompt_size.py`), which is why it is
matched rather than reconstructed.
"""


def context_bytes(argv: Sequence[str], *, hermes: str) -> int:
    """Bytes the instruction file contributes to the system prompt, measured.

    `hermes prompt-size` builds the very prompt a session would use and reports
    a per-section breakdown. It calls no model, so this costs nothing and can
    run on both trees.

    This is the answer to "did AGENTS.md actually reach the system prompt". The
    alternative was to reason from the loader's source and call that evidence,
    which is exactly how the first attempt at this check went wrong: a flag was
    switching the injection off while every line of reasoning about it stayed
    true.
    """
    probe = [
        *argv[: argv.index("--") + 1],
        hermes,
        "prompt-size",
        "--platform",
        "cli",
        "--json",
    ]
    result = subprocess.run(probe, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise SystemExit("could not measure the system prompt; see the sandbox")
    breakdown = json.loads(result.stdout)
    for label, _chars, byts in breakdown["sections"]:
        if label == CONTEXT_SECTION:
            return int(byts)
    raise SystemExit(f"prompt-size reported no {CONTEXT_SECTION!r} section")


def snapshot_home(root: Path, destination: Path) -> Path:
    """Copy the freshly-created sandbox home aside, before anything runs."""
    shutil.copytree(root / "home", destination)
    return destination


def restore_home(root: Path, pristine: Path) -> None:
    """Put the agent's state back to the snapshot, so the next run starts level.

    A run leaves a database, caches, logs and an auth record behind. Without
    this the control is not a comparison but the second half of a sequence, and
    any difference could be the order rather than the hint.
    """
    shutil.rmtree(root / "home")
    shutil.copytree(pristine, root / "home")


def assert_hint_reached_the_prompt(
    *, with_hint: int, without_hint: int, instructions: str
) -> None:
    """The two trees' prompts must differ by the hint, and by nothing else.

    An equality would be the interesting failure: it means the instruction file
    is not being loaded, and every run under it tests filesystem discovery
    while looking like a test of the hint.

    The upper bound does a second job. If the agent expanded the reference and
    pulled the index into the prompt, the difference would exceed the injected
    hint by roughly the index's own size -- so a run that passes this has
    measured, rather than argued, that the index was not inlined. Any sentinel
    that comes back afterwards came through a tool.
    """
    if with_hint <= without_hint:
        raise SystemExit(
            "the instruction file is not reaching the system prompt "
            f"({with_hint} vs {without_hint} bytes); the check cannot observe "
            "a hint being followed"
        )
    injected = len(instructions.encode("utf-8"))
    if with_hint - without_hint > injected:
        raise SystemExit(
            "the two prompts differ by more than the injected hint "
            f"({with_hint - without_hint} bytes); the runs are not comparable"
        )


def session_files(root: Path) -> list[str]:
    sessions = root / "home" / ".hermes" / "sessions"
    if not sessions.is_dir():
        return []
    return sorted(path.name for path in sessions.iterdir() if path.is_file())


def state_residue(root: Path) -> list[str]:
    """Every file under the agent's state directory, path relative to it.

    Relative rather than by name: a residue's location is half of what makes it
    diagnosable, and two same-named files in different profiles are two files.
    """
    home = root / "home" / ".hermes"
    if not home.is_dir():
        return []
    return sorted(
        path.relative_to(home).as_posix() for path in home.rglob("*") if path.is_file()
    )


def trace_lines(root: Path, names: Sequence[str]) -> list[str]:
    sessions = root / "home" / ".hermes" / "sessions"
    for name in names:
        path = sessions / name
        if path.suffix == ".jsonl" and path.is_file():
            return path.read_text(encoding="utf-8").splitlines()
    return []


def run_once(
    argv: Sequence[str], *, ledger: AttemptLedger, run_id: str, calls: int
) -> str:
    """One agent invocation, charged to the project ledger before it starts.

    Charged at the cap rather than at the actual call count, and charged up
    front. The agent calls the model itself, so nothing here can observe how
    many requests it makes -- and a ledger that waited to find out would be
    counting after the money was spent. Over-counting is the safe direction:
    the ledger exists to stop a runaway, not to bill accurately.
    """
    for index in range(calls):
        attempt = ledger.reserve(
            kind="agent_run",
            run_id=run_id,
            provider="hermes",
            model=f"iteration-{index + 1}",
        )
        ledger.settle(attempt, outcome="ok")
    result = subprocess.run(list(argv), capture_output=True, text=True, check=False)
    if result.returncode != 0:
        # The tail can carry a masked key on some failure paths, so it is
        # summarised rather than reproduced.
        raise SystemExit(
            f"agent run failed with status {result.returncode}; "
            f"{len(result.stderr)} bytes of stderr withheld (it can carry a "
            f"partially masked credential). Inspect the sandbox directly."
        )
    return result.stdout


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="verify_adapter_consumption")
    parser.add_argument("--adapter", type=Path, required=True)
    parser.add_argument("--runtime-root", type=Path, required=True)
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument("--hermes", default="hermes")
    parser.add_argument("--model", default="deepseek-v4-flash")
    parser.add_argument("--provider", default="deepseek")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--report", type=Path, default=None)
    # Only from evidence about the agent under test. See ConsumptionEvidence.
    parser.add_argument("--inlining-ruled-out", default="", metavar="REASON")
    parser.add_argument(
        "--max-turns", type=int, default=DEFAULT_MAX_ITERATIONS, metavar="N"
    )
    args = parser.parse_args(list(argv) if argv is not None else None)

    command = sandbox_argv(
        runtime_root=args.runtime_root,
        root=args.root,
        model=args.model,
        provider=args.provider,
        hermes=args.hermes,
        max_iterations=args.max_turns,
    )
    if args.dry_run:
        print(json.dumps({"argv": command, "prompt": PROMPT}, indent=2))
        return 0

    ledger = AttemptLedger()
    calls = calls_per_run(args.max_turns)
    needed = 2 * calls
    if ledger.remaining() < needed:
        raise SystemExit(
            f"refusing to start: {needed} attempts are needed and "
            f"{ledger.remaining()} remain of {ledger.ceiling}"
        )
    run_id = f"verify-{new_sentinel()[:8]}"

    assert_turn_cap(args.root, args.max_turns)
    pristine = snapshot_home(args.root, args.root / "pristine-home")

    sentinel = new_sentinel()
    index_text, instructions = prepare(
        args.root, adapter_path=args.adapter, sentinel=sentinel, inject_hint=True
    )
    # Measured before spending anything: if the hint is not in the prompt there
    # is nothing to test, and the first attempt at this check failed exactly
    # there while looking entirely healthy.
    with_hint = context_bytes(command, hermes=args.hermes)

    before = session_files(args.root)
    positive = run_once(command, ledger=ledger, run_id=run_id, calls=calls)
    after = session_files(args.root)

    # Same tree, same index, same sentinel, same agent state -- only the hint
    # is gone.
    restore_home(args.root, pristine)
    prepare(args.root, adapter_path=args.adapter, sentinel=sentinel, inject_hint=False)
    without_hint = context_bytes(command, hermes=args.hermes)
    assert_hint_reached_the_prompt(
        with_hint=with_hint, without_hint=without_hint, instructions=instructions
    )
    control = run_once(command, ledger=ledger, run_id=run_id, calls=calls)

    verdict = verify_consumption(
        ConsumptionEvidence(
            sentinel=sentinel,
            positive_output=positive,
            control_output=control,
            prompt=PROMPT,
            instructions=instructions,
            index_content=index_text,
            sessions_before=before,
            sessions_after=after,
            trace_lines=trace_lines(args.root, sorted(set(after) - set(before))),
            residue=state_residue(args.root),
            expected_tools=FILE_TOOLSET,
            index_path="/work/agentroot/memory/team/INDEX.md",
            inlining_ruled_out=args.inlining_ruled_out,
        )
    )
    _report(verdict, path=args.report)
    return 0 if verdict.consumed else 1


def _report(verdict: ConsumptionVerdict, *, path: Path | None) -> None:
    """Print, and optionally file, a verdict that quotes no agent output.

    The answers are model text produced from a file we injected; the decision is
    the thing worth keeping, and reprinting the raw output would put whatever
    the model happened to say into a report.
    """
    payload = {
        "consumed": verdict.consumed,
        "evidence_basis": verdict.evidence_basis,
        "failures": list(verdict.failures),
        "notes": list(verdict.notes),
    }
    rendered = json.dumps(payload, indent=2, sort_keys=True)
    print(rendered)
    if path is not None:
        path.write_text(rendered + "\n", encoding="utf-8")


if __name__ == "__main__":
    raise SystemExit(main())
